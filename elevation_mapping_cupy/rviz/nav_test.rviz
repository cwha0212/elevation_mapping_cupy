      Reliability Policy: Reliable
      Value: /elevation_mapping_node/elevation_map_terrain
    Use Rainbow: true
    Value: true
  - Alpha: 1
    Autocompute Intensity Bounds: true
    Class: rviz_default_plugins/PointCloud2
    Color: 255; 60; 40
    Color Transformer: FlatColor
    Decay Time: 0
    Enabled: true
    Name: TravObstacles
    Position Transformer: XYZ
    Selectable: true
    Size (Pixels): 3
    Size (m): 0.06
    Style: Boxes
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /traversability/obstacles
    Use Fixed Frame: true
    Use rainbow: true
    Value: true
  - Alpha: 0.8
    Class: rviz_default_plugins/Map
    Color Scheme: costmap
    Draw Behind: false
    Enabled: true
    Name: GaitGrid
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
