<?xml version="1.0" ?>
<!--
  Gazebo Fortress world for the elevation mapping demo.

  Replaces the old turtlesim demo, which targeted Gazebo Classic: Classic 11
  reached EOL and neither gazebo_ros_pkgs nor turtlebot3_gazebo ship binaries
  any more, and no TurtleBot3 world was ever ported to Fortress. So the robot
  and the terrain are defined here instead.

  The terrain is chosen for what elevation mapping is actually asked to
  resolve: a ramp, a stair flight, and a curb-height step. The curb is the
  interesting one: it is the geometric feature that separates roadway from
  sidewalk, and at 0.12 m it is exactly the scale a 0.1 m map smears away.
-->
<sdf version="1.9">
  <world name="elevation_demo">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <!-- Renders the lidar and the camera. Without this they stay silent. -->
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.3 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry>
          <material>
            <ambient>0.45 0.45 0.45 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Ramp: 12 degrees. Centered so the west end of the top face meets the
         ground (z = L/2*sin(12deg) - t/2/cos(12deg)): the robot can drive
         straight onto it, and the whole face is above ground for the lidar.
         The old pose centered it at z=0, burying most of it. -->
    <model name="ramp">
      <static>true</static>
      <pose>4.0 -1.5 0.2607 0 -0.2094 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3.0 2.0 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.0 2.0 0.1</size></box></geometry>
          <material>
            <ambient>0.3 0.4 0.6 1</ambient>
            <diffuse>0.35 0.5 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Stair flight: four 0.15 m risers, a quadruped-scale step height. -->
    <model name="stairs">
      <static>true</static>
      <pose>4.0 2.5 0 0 0 0</pose>
      <link name="link">
        <collision name="s1"><pose>0.00 0 0.075 0 0 0</pose>
          <geometry><box><size>0.4 2.0 0.15</size></box></geometry></collision>
        <visual name="v1"><pose>0.00 0 0.075 0 0 0</pose>
          <geometry><box><size>0.4 2.0 0.15</size></box></geometry></visual>
        <collision name="s2"><pose>0.40 0 0.150 0 0 0</pose>
          <geometry><box><size>0.4 2.0 0.30</size></box></geometry></collision>
        <visual name="v2"><pose>0.40 0 0.150 0 0 0</pose>
          <geometry><box><size>0.4 2.0 0.30</size></box></geometry></visual>
        <collision name="s3"><pose>0.80 0 0.225 0 0 0</pose>
          <geometry><box><size>0.4 2.0 0.45</size></box></geometry></collision>
        <visual name="v3"><pose>0.80 0 0.225 0 0 0</pose>
          <geometry><box><size>0.4 2.0 0.45</size></box></geometry></visual>
        <collision name="s4"><pose>1.20 0 0.300 0 0 0</pose>
          <geometry><box><size>0.4 2.0 0.60</size></box></geometry></collision>
        <visual name="v4"><pose>1.20 0 0.300 0 0 0</pose>
          <geometry><box><size>0.4 2.0 0.60</size></box></geometry></visual>
      </link>
    </model>

    <!-- Curb: 0.12 m. The whole point of running at 0.05 m resolution. -->
    <model name="curb">
      <static>true</static>
      <pose>2.0 0 0.06 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.25 6.0 0.12</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.25 6.0 0.12</size></box></geometry>
          <material>
            <ambient>0.6 0.55 0.45 1</ambient>
            <diffuse>0.75 0.7 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- A wall, so something clearly lethal shows up next to the terrain. -->
    <model name="wall">
      <static>true</static>
      <pose>6.5 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 4.0 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 4.0 1.0</size></box></geometry>
          <material>
            <ambient>0.5 0.3 0.3 1</ambient>
            <diffuse>0.65 0.35 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Colour markers for the projection check. Their world positions are the
         ground truth. Whatever cell the colour lands on in the map should be
         these coordinates. 1 cm thick so they barely move the elevation. -->
    <model name="marker_red">
      <static>true</static>
      <pose>1.2 0.4 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.4 0.4 0.01</size></box></geometry>
          <material>
            <ambient>0.8 0.0 0.0 1</ambient>
            <diffuse>1.0 0.0 0.0 1</diffuse>
            <emissive>0.3 0.0 0.0 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <model name="marker_blue">
      <static>true</static>
      <pose>1.2 -0.4 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.4 0.4 0.01</size></box></geometry>
          <material>
            <ambient>0.0 0.0 0.8 1</ambient>
            <diffuse>0.0 0.0 1.0 1</diffuse>
            <emissive>0.0 0.0 0.3 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- Differential-drive robot: 360 degree lidar for geometry, a forward
         colour camera for semantics. Same split as haechi. -->
    <model name="robot">
      <pose>0 0 0.12 0 0 0</pose>
      <self_collide>false</self_collide>

      <link name="base_link">
        <inertial>
          <mass>6.0</mass>
          <inertia><ixx>0.08</ixx><iyy>0.10</iyy><izz>0.12</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.40 0.30 0.14</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.40 0.30 0.14</size></box></geometry>
          <material>
            <ambient>0.2 0.2 0.24 1</ambient>
            <diffuse>0.3 0.3 0.36 1</diffuse>
          </material>
        </visual>

        <!-- Geometry comes from a 360 degree lidar, as it does on haechi: the
             map has to fill in all around the robot, not just inside a camera
             cone. The vertical span leans downward so the near ground is
             covered the way the tilted MID360 mounts cover it. -->
        <sensor name="lidar" type="gpu_lidar">
          <pose>0 0 0.25 0 0 0</pose>
          <update_rate>10</update_rate>
          <always_on>true</always_on>
          <topic>lidar</topic>
          <lidar>
            <scan>
              <horizontal>
                <samples>720</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159</min_angle>
                <max_angle>3.14159</max_angle>
              </horizontal>
              <vertical>
                <samples>32</samples>
                <resolution>1</resolution>
                <min_angle>-0.5236</min_angle>
                <max_angle>0.1745</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.15</min>
              <max>20.0</max>
              <resolution>0.01</resolution>
            </range>
          </lidar>
        </sensor>

        <sensor name="color" type="camera">
          <pose>0.25 0 0.28 0 0.3491 0</pose>
          <update_rate>10</update_rate>
          <always_on>true</always_on>
          <topic>color_cam</topic>
          <camera>
            <horizontal_fov>1.2217</horizontal_fov>
            <image><width>320</width><height>240</height><format>R8G8B8</format></image>
            <clip><near>0.10</near><far>12.0</far></clip>
          </camera>
        </sensor>
      </link>

      <link name="left_wheel">
        <pose>-0.10 0.17 -0.04 -1.5707 0 0</pose>
        <inertial>
          <mass>0.6</mass>
          <inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.003</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.08</radius><length>0.05</length></cylinder></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.08</radius><length>0.05</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>
      </link>

      <link name="right_wheel">
        <pose>-0.10 -0.17 -0.04 -1.5707 0 0</pose>
        <inertial>
          <mass>0.6</mass>
          <inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.003</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.08</radius><length>0.05</length></cylinder></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.08</radius><length>0.05</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>
      </link>

      <link name="caster">
        <pose>0.15 0 -0.08 0 0 0</pose>
        <inertial>
          <mass>0.2</mass>
          <inertia><ixx>0.0002</ixx><iyy>0.0002</iyy><izz>0.0002</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><sphere><radius>0.04</radius></sphere></geometry>
          <surface><friction><ode><mu>0.05</mu><mu2>0.05</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.04</radius></sphere></geometry>
        </visual>
      </link>

      <joint name="left_wheel_joint" type="revolute">
        <parent>base_link</parent><child>left_wheel</child>
        <axis><xyz expressed_in="__model__">0 1 0</xyz>
          <limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>
      <joint name="right_wheel_joint" type="revolute">
        <parent>base_link</parent><child>right_wheel</child>
        <axis><xyz expressed_in="__model__">0 1 0</xyz>
          <limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>
      <joint name="caster_joint" type="ball">
        <parent>base_link</parent><child>caster</child>
      </joint>

      <!-- Wheel odometry from DiffDrive is planar: climb the ramp and its
           z and pitch stay zero, which would corrupt both maps through TF and
           make the climbing comparison meaningless. haechi gets a full 3D pose
           from its LIO, so the demo publishes the true 3D pose here and the
           launch bridges THIS to /tf, not the DiffDrive one. -->
      <plugin filename="ignition-gazebo-odometry-publisher-system"
              name="ignition::gazebo::systems::OdometryPublisher">
        <odom_frame>odom</odom_frame>
        <robot_base_frame>base_link</robot_base_frame>
        <dimensions>3</dimensions>
        <odom_publish_frequency>50</odom_publish_frequency>
        <odom_topic>/model/robot/odom3d</odom_topic>
        <tf_topic>/model/robot/pose3d</tf_topic>
      </plugin>

      <plugin filename="ignition-gazebo-diff-drive-system"
              name="ignition::gazebo::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.34</wheel_separation>
        <wheel_radius>0.08</wheel_radius>
        <odom_publish_frequency>50</odom_publish_frequency>
        <max_linear_acceleration>1.0</max_linear_acceleration>
        <topic>/model/robot/cmd_vel</topic>
        <odom_topic>/model/robot/odometry</odom_topic>
        <tf_topic>/model/robot/tf</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_link</child_frame_id>
      </plugin>
    </model>

  </world>
</sdf>
