<?xml version="1.0" ?>
<!--
  Gazebo Fortress world for the semantic projection demo.

  A sidewalk, a curb, and a roadway beside it, with obstacles on both. This is
  the arrangement the whole semantic branch exists for: the roadway is as flat
  and as crossable as the sidewalk, a quadruped steps off the curb without
  noticing, and nothing in the geometry says it should not. Only the label
  does.

  Layout, all known positions so the map can be checked against them:

    pavement   y in [-1.5,  5.5]   flat, 0.12 m above the road, 34 m long
    wall       y = 5.50            one long side is closed by the facade
    kerb       y = -1.50           the other is a 0.12 m drop to the roadway
    island     y in [ 1.0,  3.0]   everything to be judged, in one row:
                 stairs    x  8.0.. 9.8   four 0.15 m risers
                 landing   x  9.8..10.9   floor at the top, 0.60 m
                 bank 25   x 13.4..15.6
                 bank 35   x 18.2..20.6
                 hill      x 23.0..30.1   11.3 deg up, crest at 0.72, 11.3 deg down
    car        (7.0, -3.4)         parked on the roadway, clear of the kerb

  The lanes either side of the island are 2.5 m, so the robot can circuit it,
  and from either lane the boundary it faces is inside the 3.5 m march.

  The road surface is deliberately at ground level and the sidewalk raised, so
  a robot on the sidewalk faces a drop rather than a climb: the direction
  that matters, since falling into traffic is the failure being guarded
  against.
-->
<sdf version="1.9">
  <world name="semantic_demo">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Bright and frontal: the segmentation was trained on daylight photos,
         and a dim scene costs recognition before anything else is tested. -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>
    <light type="directional" name="fill">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.5 0.5 0.5 1</diffuse>
      <direction>0.6 -0.3 -0.7</direction>
    </light>

    <!-- Roadway: flat, at z=0, dark asphalt. -->
    <model name="roadway">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>80 80</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>80 80</size></plane></geometry>
          <material>
            <diffuse>1 1 1</diffuse>
            <specular>0.05 0.05 0.05</specular>
            <pbr><metal>
              <albedo_map>@TEXTURES@/asphalt.png</albedo_map>
              <roughness>0.9</roughness>
              <metalness>0.0</metalness>
            </metal></pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- Sidewalk: raised 0.12 m, pale paving. Its edge at y=0.4 is the curb. -->
    <model name="sidewalk">
      <static>true</static>
      <pose>15.0 2.0 0.06 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>34.0 7.0 0.12</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>34.0 7.0 0.12</size></box></geometry>
          <material>
            <diffuse>1 1 1</diffuse>
            <specular>0.05 0.05 0.05</specular>
            <pbr><metal>
              <albedo_map>@TEXTURES@/sidewalk.png</albedo_map>
              <roughness>0.9</roughness>
              <metalness>0.0</metalness>
            </metal></pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- A building front along the far side of the walk. Cityscapes learned
         streets as a layout, not as a pair of surfaces, and a road with
         nothing standing beside it is not a street it was ever shown. -->
    <model name="facade">
      <static>true</static>
      <pose>15.0 5.7 2.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>34.0 0.4 4.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>34.0 0.4 4.0</size></box></geometry>
          <material>
            <diffuse>1 1 1</diffuse>
            <specular>0.05 0.05 0.05</specular>
            <pbr><metal>
              <albedo_map>@TEXTURES@/facade.png</albedo_map>
              <roughness>0.9</roughness>
              <metalness>0.0</metalness>
            </metal></pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- A wall segment on the sidewalk: an obstacle the geometry alone should
         already refuse, so the semantic and geometric verdicts can be told
         apart in the same scene. -->

    <!-- A stair flight rising from the sidewalk: four 0.15 m risers, the same
         geometry the terrain demo verified the step layer against (median
         0.140 measured vs 0.15 true). Here it faces the full stack at once:
         the lidar builds the steps, the step/drivability chain judges them,
         SAM-TP scores their appearance, and the 2D grid shows the verdict. -->
    <model name="stairs">
      <static>true</static>
      <pose>8.2 1.9 0.12 0 0 0</pose>
      <link name="link">
        <collision name="s1"><pose>0.2 0 0.075 0 0 0</pose>
          <geometry><box><size>0.4 2.0 0.15</size></box></geometry></collision>
        <visual name="v1"><pose>0.2 0 0.075 0 0 0</pose>
          <geometry><box><size>0.4 2.0 0.15</size></box></geometry>
          <material>
            <diffuse>1 1 1</diffuse>
            <pbr><metal>
              <albedo_map>@TEXTURES@/sidewalk.png</albedo_map>
              <roughness>0.9</roughness><metalness>0.0</metalness>
            </metal></pbr>
          </material></visual>
        <collision name="s2"><pose>0.6 0 0.150 0 0 0</pose>
          <geometry><box><size>0.4 2.0 0.30</size></box></geometry></collision>
        <visual name="v2"><pose>0.6 0 0.150 0 0 0</pose>
          <geometry><box><size>0.4 2.0 0.30</size></box></geometry>
          <material>
            <diffuse>1 1 1</diffuse>
            <pbr><metal>
              <albedo_map>@TEXTURES@/sidewalk.png</albedo_map>
              <roughness>0.9</roughness><metalness>0.0</metalness>
            </metal></pbr>
          </material></visual>
        <collision name="s3"><pose>1.0 0 0.225 0 0 0</pose>
          <geometry><box><size>0.4 2.0 0.45</size></box></geometry></collision>
        <visual name="v3"><pose>1.0 0 0.225 0 0 0</pose>
          <geometry><box><size>0.4 2.0 0.45</size></box></geometry>
          <material>
            <diffuse>1 1 1</diffuse>
            <pbr><metal>
              <albedo_map>@TEXTURES@/sidewalk.png</albedo_map>
              <roughness>0.9</roughness><metalness>0.0</metalness>
            </metal></pbr>
          </material></visual>
        <collision name="s4"><pose>1.4 0 0.300 0 0 0</pose>
          <geometry><box><size>0.4 2.0 0.60</size></box></geometry></collision>
        <visual name="v4"><pose>1.4 0 0.300 0 0 0</pose>
          <geometry><box><size>0.4 2.0 0.60</size></box></geometry>
          <material>
            <diffuse>1 1 1</diffuse>
            <pbr><metal>
              <albedo_map>@TEXTURES@/sidewalk.png</albedo_map>
              <roughness>0.9</roughness><metalness>0.0</metalness>
            </metal></pbr>
          </material></visual>
      </link>
    </model>


    <!-- Detector fixtures. The stairs filter has never been shown a plain
         slope: a 5 cell max-minus-min span puts any plane between roughly
         18 and 47 degrees inside the riser band, with enough relief to pass
         the climb test and nothing tall enough to trip the wall veto, so a
         bank reads as a climbable flight and is lifted to passable over
         drivability's correct refusal. The demo ramp is 12 degrees, below
         even the climb trigger, which is why this never showed. These two
         sit squarely in the danger band. Both must come back with zero
         flagged cells. -->
    <!-- Stairs go somewhere. Without this the flight topped out on a 0.6 m
         cliff, the crest was marked lethal - correctly - and the corridor
         test was asking for a route off a drop. Real flights end on a floor;
         this is that floor. -->
    <model name="stair_landing">
      <static>true</static>
      <pose>10.35 1.9 0.30 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>1.10 2.0 0.60</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.10 2.0 0.60</size></box></geometry>
          <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="slope25">
      <static>true</static>
      <pose>14.500 2.0 0.360 0 -0.4363 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>2.207 2.0 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.207 2.0 0.5</size></box></geometry>
          <material><ambient>0.30 0.26 0.22 1</ambient><diffuse>0.42 0.36 0.30 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="slope35">
      <static>true</static>
      <pose>19.400 2.0 0.615 0 -0.6109 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>2.442 2.0 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.442 2.0 0.5</size></box></geometry>
          <material><ambient>0.30 0.26 0.22 1</ambient><diffuse>0.42 0.36 0.30 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Two tiers 1.2 m deep. Geometrically a staircase in every respect
         except tread depth, which is the only thing that separates a flight
         from terracing, planters and stadium seating. -->


    <!-- A ramp the wheeled stand-in can actually drive, onto a platform,
         with a flight descending off the far end. Descent is the case that
         matters most and the one no ground-level approach can produce: the
         robot has to be standing at the top to see it. -->
    <!-- The hill. Up one side, over the crest, down the other - the terrain
         a route has to cross rather than skirt, which is the whole test: a
         planner that treats the up-slope as a wall never reaches the far
         side. Both faces are the D1 MaxPro's easy case (11.3 deg) and the
         crest is flat and a full robot length long. -->
    <model name="ramp_up">
      <static>true</static>
      <pose>24.500 2.0 0.175 0 -0.1974 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>3.059 2.0 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3.059 2.0 0.5</size></box></geometry>
          <material><ambient>0.5 0.52 0.55 1</ambient><diffuse>0.5 0.52 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Crest top must equal the ramp heads exactly. The ramp's top face
         starts at pavement height 0.12 and climbs 3.059 * sin(11.31 deg)
         = 0.60, so the heads meet the crest at 0.72 - not 0.61, which was
         that same 0.60 miscounted from the ground instead of the pavement
         and left an 0.11 m step at both joints. -->
    <model name="hill_crest">
      <static>true</static>
      <!-- 1.18 long, not 1.00. A tilted slab's TOP face ends short of its
           footprint: the up-ramp's top corner sits at x=25.95 and its
           bevelled end face falls to 0.23 by x=26.05, so a crest that starts
           at its footprint edge leaves an 8 cm, half-metre-deep notch at
           each joint - which the lidar read as a step and dressed the crest
           in phantom obstacles. The crest now spans corner to corner. -->
      <pose>26.530 2.0 0.360 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>1.18 2.0 0.72</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.18 2.0 0.72</size></box></geometry>
          <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="ramp_down">
      <static>true</static>
      <pose>28.560 2.0 0.175 0 0.1974 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>3.059 2.0 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3.059 2.0 0.5</size></box></geometry>
          <material><ambient>0.5 0.52 0.55 1</ambient><diffuse>0.5 0.52 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>








    <include>
      <name>car</name>
      <pose>7.0 -3.4 0 0 0 0</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Hatchback</uri>
    </include>

    <!-- Same robot as the terrain demo: 360 lidar for geometry, forward colour
         camera for labels. The camera here feeds semantic_sensor rather than
         going straight into the map as raw rgb. -->
    <!-- Stand-in for haechi: an AgiBot D1 MaxPro (1270 x 520 x 730 mm,
         68 kg, climbs 30 cm continuous stairs, 45 deg gradient). Wheeled
         rather than legged because only the sensor geometry and the
         footprint reach the mapping layer; the gait does not. -->
    <model name="robot">
      <pose>2.0 4.2 0.62 0 0 0</pose>
      <self_collide>false</self_collide>

      <link name="base_link">
        <inertial>
          <mass>68.0</mass>
          <inertia><ixx>2.11</ixx><iyy>9.72</iyy><izz>10.67</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>1.27 0.52 0.32</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.27 0.52 0.32</size></box></geometry>
          <material>
            <ambient>0.2 0.2 0.24 1</ambient>
            <diffuse>0.3 0.3 0.36 1</diffuse>
          </material>
        </visual>

        <!-- haechi carries an RSAIRY up front and two MID360s angled
             down at the sides, but elevation mapping is only ever fed their
             MERGED cloud, so one sensor with the merged coverage is the
             faithful stand-in: 360 deg round, 90 deg tall (-60..+30), at
             deck height. The old 40 deg band could not see a staircase. -->
        <sensor name="lidar" type="gpu_lidar">
          <!-- At the RSAIRY's calibrated spot: the nose, a hand below the
               deck. Sitting it on the deck instead made the robot scan its
               own back: the body shadowed almost every downward ray and
               the map filled with the chassis top at 0.78 m. -->
          <pose>0.66 -0.07 0.0 0 0 0</pose>
          <update_rate>10</update_rate>
          <always_on>true</always_on>
          <topic>lidar</topic>
          <lidar>
            <scan>
              <horizontal>
                <samples>360</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159</min_angle>
                <max_angle>3.14159</max_angle>
              </horizontal>
              <vertical>
                <!-- 360x16 rather than 720x32. Every raycast runs on the same
                     GPU as the camera, the segmentation and RViz, and at the
                     full count RViz stopped repainting. A 0.05 m map does not
                     resolve more than this anyway. -->
                <samples>32</samples>
                <resolution>1</resolution>
                <min_angle>-1.0472</min_angle>
                <max_angle>0.5236</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.15</min>
              <max>20.0</max>
              <resolution>0.01</resolution>
            </range>
          </lidar>
        </sensor>

        <!-- The two MID360s, at their calibrated mounts (haechi_calibration
             .yaml, T_lidarframe_sensor with the sim's base sitting 0.159 m
             above lidar_frame - the same offset the camera pose already
             uses). Both are tilted ~33 deg down and yawed to the sides, so
             between them and the nose RSAIRY the robot sees the ground all
             round instead of only where the nose sensor's cone reaches.
             240x16 rather than the front's 360x32: every ray shares the GPU
             with the camera and the segmentation, and the sides only need
             near-field ground. -->
        <sensor name="lidar_left" type="gpu_lidar">
          <pose>-0.023 0.034 0.189 -0.015359 -0.604931 -1.551598</pose>
          <update_rate>10</update_rate>
          <always_on>true</always_on>
          <topic>lidar_left</topic>
          <lidar>
            <scan>
              <horizontal>
                <samples>240</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159</min_angle>
                <max_angle>3.14159</max_angle>
              </horizontal>
              <vertical>
                <samples>16</samples>
                <resolution>1</resolution>
                <min_angle>-0.1222</min_angle>
                <max_angle>0.9076</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.10</min>
              <max>20.0</max>
              <resolution>0.01</resolution>
            </range>
          </lidar>
        </sensor>

        <sensor name="lidar_right" type="gpu_lidar">
          <pose>-0.024 -0.180 0.187 0.000000 -0.558505 1.570796</pose>
          <update_rate>10</update_rate>
          <always_on>true</always_on>
          <topic>lidar_right</topic>
          <lidar>
            <scan>
              <horizontal>
                <samples>240</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159</min_angle>
                <max_angle>3.14159</max_angle>
              </horizontal>
              <vertical>
                <samples>16</samples>
                <resolution>1</resolution>
                <min_angle>-0.1222</min_angle>
                <max_angle>0.9076</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.10</min>
              <max>20.0</max>
              <resolution>0.01</resolution>
            </range>
          </lidar>
        </sensor>

        <!-- Level, not tilted down: a downward camera sees mostly floor, and
             the model needs to see the people standing on it. 640x480 because
             the network resizes anyway and detail matters more than rate. -->
        <sensor name="color" type="camera">
          <pose>0.675 -0.063 0.135 0.0 -0.058 0.047</pose>
          <!-- 4 Hz, not 10. Everything here renders on the same GPU: the
               simulator's own view, this camera, the lidar's raycast, the
               segmentation and RViz. At 10 Hz the total sat at 97% and RViz
               stopped repainting. Labels persist in the map, so a slower
               camera costs coverage nothing. -->
          <update_rate>4</update_rate>
          <always_on>true</always_on>
          <topic>color_cam</topic>
          <camera>
            <horizontal_fov>1.5800</horizontal_fov>
            <image><width>640</width><height>360</height><format>R8G8B8</format></image>
            <clip><near>0.10</near><far>20.0</far></clip>
          </camera>
        </sensor>
      </link>

      <link name="left_wheel">
        <pose>-0.35 0.26 -0.16 -1.5707 0 0</pose>
        <inertial>
          <mass>4.0</mass>
          <inertia><ixx>0.119</ixx><iyy>0.119</iyy><izz>0.231</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.34</radius><length>0.10</length></cylinder></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.34</radius><length>0.10</length></cylinder></geometry>
        </visual>
      </link>

      <link name="right_wheel">
        <pose>-0.35 -0.26 -0.16 -1.5707 0 0</pose>
        <inertial>
          <mass>4.0</mass>
          <inertia><ixx>0.119</ixx><iyy>0.119</iyy><izz>0.231</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.34</radius><length>0.10</length></cylinder></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.34</radius><length>0.10</length></cylinder></geometry>
        </visual>
      </link>

      <link name="caster">
        <pose>0.45 0 -0.16 0 0 0</pose>
        <inertial>
          <mass>2.0</mass>
          <inertia><ixx>0.0925</ixx><iyy>0.0925</iyy><izz>0.0925</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><sphere><radius>0.34</radius></sphere></geometry>
          <surface><friction><ode><mu>0.05</mu><mu2>0.05</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.34</radius></sphere></geometry>
        </visual>
      </link>

      <joint name="left_wheel_joint" type="revolute">
        <parent>base_link</parent><child>left_wheel</child>
        <axis><xyz expressed_in="__model__">0 1 0</xyz>
          <limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>
      <joint name="right_wheel_joint" type="revolute">
        <parent>base_link</parent><child>right_wheel</child>
        <axis><xyz expressed_in="__model__">0 1 0</xyz>
          <limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>
      <joint name="caster_joint" type="ball">
        <parent>base_link</parent><child>caster</child>
      </joint>

      <plugin filename="ignition-gazebo-odometry-publisher-system"
              name="ignition::gazebo::systems::OdometryPublisher">
        <odom_frame>odom</odom_frame>
        <robot_base_frame>base_link</robot_base_frame>
        <dimensions>3</dimensions>
        <odom_publish_frequency>50</odom_publish_frequency>
        <odom_topic>/model/robot/odom3d</odom_topic>
        <tf_topic>/model/robot/pose3d</tf_topic>
      </plugin>

      <plugin filename="ignition-gazebo-diff-drive-system"
              name="ignition::gazebo::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.52</wheel_separation>
        <wheel_radius>0.34</wheel_radius>
        <odom_publish_frequency>50</odom_publish_frequency>
        <max_linear_acceleration>1.0</max_linear_acceleration>
        <topic>/model/robot/cmd_vel</topic>
        <odom_topic>/model/robot/odometry</odom_topic>
        <tf_topic>/model/robot/tf</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_link</child_frame_id>
      </plugin>
    </model>

  </world>
</sdf>
