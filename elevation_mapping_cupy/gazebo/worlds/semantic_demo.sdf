<?xml version="1.0" ?>
<!--
  Gazebo Fortress world for the semantic projection demo.

  A sidewalk, a curb, and a roadway beside it, with obstacles on both. This is
  the arrangement the whole semantic branch exists for: the roadway is as flat
  and as crossable as the sidewalk, a quadruped steps off the curb without
  noticing, and nothing in the geometry says it should not. Only the label
  does.

  Layout, all known positions so the map can be checked against them:

    sidewalk   y in [ 0.4,  3.4]   flat, 0.12 m above the road
    curb       y = 0.4             0.12 m riser, the geometric boundary
    roadway    y in [-3.6,  0.4]   flat, asphalt dark
    person     (3.0, +1.8)         on the sidewalk
    car        (7.0, -1.6)         on the roadway
    obstacle   (5.0, +2.4)         a wall segment on the sidewalk

  The road surface is deliberately at ground level and the sidewalk raised, so
  a robot on the sidewalk faces a drop rather than a climb: the direction
  that matters, since falling into traffic is the failure being guarded
  against.
-->
<sdf version="1.9">
  <world name="semantic_demo">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Bright and frontal: the segmentation was trained on daylight photos,
         and a dim scene costs recognition before anything else is tested. -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>
    <light type="directional" name="fill">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.5 0.5 0.5 1</diffuse>
      <direction>0.6 -0.3 -0.7</direction>
    </light>

    <!-- Roadway: flat, at z=0, dark asphalt. -->
    <model name="roadway">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>80 80</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>80 80</size></plane></geometry>
          <material>
            <diffuse>1 1 1</diffuse>
            <specular>0.05 0.05 0.05</specular>
            <pbr><metal>
              <albedo_map>@TEXTURES@/asphalt.png</albedo_map>
              <roughness>0.9</roughness>
              <metalness>0.0</metalness>
            </metal></pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- Sidewalk: raised 0.12 m, pale paving. Its edge at y=0.4 is the curb. -->
    <model name="sidewalk">
      <static>true</static>
      <pose>10.0 1.9 0.06 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>40.0 3.0 0.12</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>40.0 3.0 0.12</size></box></geometry>
          <material>
            <diffuse>1 1 1</diffuse>
            <specular>0.05 0.05 0.05</specular>
            <pbr><metal>
              <albedo_map>@TEXTURES@/sidewalk.png</albedo_map>
              <roughness>0.9</roughness>
              <metalness>0.0</metalness>
            </metal></pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- A building front along the far side of the walk. Cityscapes learned
         streets as a layout, not as a pair of surfaces, and a road with
         nothing standing beside it is not a street it was ever shown. -->
    <model name="facade">
      <static>true</static>
      <pose>10.0 3.9 2.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>40.0 0.4 4.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>40.0 0.4 4.0</size></box></geometry>
          <material>
            <diffuse>1 1 1</diffuse>
            <specular>0.05 0.05 0.05</specular>
            <pbr><metal>
              <albedo_map>@TEXTURES@/facade.png</albedo_map>
              <roughness>0.9</roughness>
              <metalness>0.0</metalness>
            </metal></pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- A wall segment on the sidewalk: an obstacle the geometry alone should
         already refuse, so the semantic and geometric verdicts can be told
         apart in the same scene. -->
    <model name="obstacle">
      <static>true</static>
      <pose>5.0 2.4 0.47 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 0.6 0.7</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.6 0.7</size></box></geometry>
          <material>
            <ambient>0.45 0.30 0.25 1</ambient>
            <diffuse>0.60 0.40 0.33 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <name>person_a</name>
      <pose>3.0 1.8 0.12 0 0 3.14159</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Casual female</uri>
    </include>

    <include>
      <name>person_b</name>
      <pose>8.5 2.6 0.12 0 0 3.14159</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Standing person</uri>
    </include>

    <include>
      <name>car</name>
      <pose>7.0 -1.6 0 0 0 0</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Hatchback</uri>
    </include>

    <!-- Same robot as the terrain demo: 360 lidar for geometry, forward colour
         camera for labels. The camera here feeds semantic_sensor rather than
         going straight into the map as raw rgb. -->
    <model name="robot">
      <pose>0 1.9 0.24 0 0 0</pose>
      <self_collide>false</self_collide>

      <link name="base_link">
        <inertial>
          <mass>6.0</mass>
          <inertia><ixx>0.08</ixx><iyy>0.10</iyy><izz>0.12</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.40 0.30 0.14</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.40 0.30 0.14</size></box></geometry>
          <material>
            <ambient>0.2 0.2 0.24 1</ambient>
            <diffuse>0.3 0.3 0.36 1</diffuse>
          </material>
        </visual>

        <sensor name="lidar" type="gpu_lidar">
          <pose>0 0 0.25 0 0 0</pose>
          <update_rate>10</update_rate>
          <always_on>true</always_on>
          <topic>lidar</topic>
          <lidar>
            <scan>
              <horizontal>
                <samples>360</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159</min_angle>
                <max_angle>3.14159</max_angle>
              </horizontal>
              <vertical>
                <!-- 360x16 rather than 720x32. Every raycast runs on the same
                     GPU as the camera, the segmentation and RViz, and at the
                     full count RViz stopped repainting. A 0.05 m map does not
                     resolve more than this anyway. -->
                <samples>16</samples>
                <resolution>1</resolution>
                <min_angle>-0.5236</min_angle>
                <max_angle>0.1745</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.15</min>
              <max>20.0</max>
              <resolution>0.01</resolution>
            </range>
          </lidar>
        </sensor>

        <!-- Level, not tilted down: a downward camera sees mostly floor, and
             the model needs to see the people standing on it. 640x480 because
             the network resizes anyway and detail matters more than rate. -->
        <sensor name="color" type="camera">
          <pose>0.25 0 0.28 0 0.0873 0</pose>
          <!-- 4 Hz, not 10. Everything here renders on the same GPU: the
               simulator's own view, this camera, the lidar's raycast, the
               segmentation and RViz. At 10 Hz the total sat at 97% and RViz
               stopped repainting. Labels persist in the map, so a slower
               camera costs coverage nothing. -->
          <update_rate>4</update_rate>
          <always_on>true</always_on>
          <topic>color_cam</topic>
          <camera>
            <horizontal_fov>1.2217</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.10</near><far>20.0</far></clip>
          </camera>
        </sensor>
      </link>

      <link name="left_wheel">
        <pose>-0.10 0.17 -0.04 -1.5707 0 0</pose>
        <inertial>
          <mass>0.6</mass>
          <inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.003</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.08</radius><length>0.05</length></cylinder></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.08</radius><length>0.05</length></cylinder></geometry>
        </visual>
      </link>

      <link name="right_wheel">
        <pose>-0.10 -0.17 -0.04 -1.5707 0 0</pose>
        <inertial>
          <mass>0.6</mass>
          <inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.003</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.08</radius><length>0.05</length></cylinder></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.08</radius><length>0.05</length></cylinder></geometry>
        </visual>
      </link>

      <link name="caster">
        <pose>0.15 0 -0.08 0 0 0</pose>
        <inertial>
          <mass>0.2</mass>
          <inertia><ixx>0.0002</ixx><iyy>0.0002</iyy><izz>0.0002</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><sphere><radius>0.04</radius></sphere></geometry>
          <surface><friction><ode><mu>0.05</mu><mu2>0.05</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.04</radius></sphere></geometry>
        </visual>
      </link>

      <joint name="left_wheel_joint" type="revolute">
        <parent>base_link</parent><child>left_wheel</child>
        <axis><xyz expressed_in="__model__">0 1 0</xyz>
          <limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>
      <joint name="right_wheel_joint" type="revolute">
        <parent>base_link</parent><child>right_wheel</child>
        <axis><xyz expressed_in="__model__">0 1 0</xyz>
          <limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>
      <joint name="caster_joint" type="ball">
        <parent>base_link</parent><child>caster</child>
      </joint>

      <plugin filename="ignition-gazebo-odometry-publisher-system"
              name="ignition::gazebo::systems::OdometryPublisher">
        <odom_frame>odom</odom_frame>
        <robot_base_frame>base_link</robot_base_frame>
        <dimensions>3</dimensions>
        <odom_publish_frequency>50</odom_publish_frequency>
        <odom_topic>/model/robot/odom3d</odom_topic>
        <tf_topic>/model/robot/pose3d</tf_topic>
      </plugin>

      <plugin filename="ignition-gazebo-diff-drive-system"
              name="ignition::gazebo::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.34</wheel_separation>
        <wheel_radius>0.08</wheel_radius>
        <odom_publish_frequency>50</odom_publish_frequency>
        <max_linear_acceleration>1.0</max_linear_acceleration>
        <topic>/model/robot/cmd_vel</topic>
        <odom_topic>/model/robot/odometry</odom_topic>
        <tf_topic>/model/robot/tf</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_link</child_frame_id>
      </plugin>
    </model>

  </world>
</sdf>
