<?xml version="1.0"?>
<package format="3">
    <name>elevation_mapping_cupy</name>
    <version>2.2.0</version>
    <description>GPU elevation mapping and terrain judgement for the haechi quadruped (local-costmap feed for Nav2)</description>
    <maintainer email="takahiro.miki1992@gmail.com">Takahiro Miki</maintainer>
    <maintainer email="lorenzoterenzi96@gmail.com">Lorenzo Terenzi</maintainer>
    <license>MIT</license>

    <buildtool_depend>ament_cmake</buildtool_depend>
    <buildtool_depend>ament_cmake_python</buildtool_depend>

    <!-- terrain_grid_node (C++) -->
    <depend>rclcpp</depend>
    <depend>std_msgs</depend>
    <depend>geometry_msgs</depend>
    <depend>nav_msgs</depend>
    <depend>grid_map_msgs</depend>
    <depend>grid_map_core</depend>
    <depend>grid_map_ros</depend>
    <depend>tf2_ros</depend>

    <!-- Python nodes and launch -->
    <exec_depend>rclpy</exec_depend>
    <exec_depend>launch</exec_depend>
    <exec_depend>launch_ros</exec_depend>
    <exec_depend>ament_index_python</exec_depend>
    <exec_depend>elevation_map_msgs</exec_depend>
    <exec_depend>sensor_msgs</exec_depend>
    <exec_depend>sensor_msgs_py</exec_depend>
    <exec_depend>visualization_msgs</exec_depend>
    <exec_depend>std_srvs</exec_depend>
    <exec_depend>nav2_msgs</exec_depend>
    <exec_depend>message_filters</exec_depend>
    <exec_depend>cv_bridge</exec_depend>
    <exec_depend>tf_transformations</exec_depend>
    <exec_depend>python3-numpy</exec_depend>
    <exec_depend>python3-scipy</exec_depend>
    <exec_depend>python3-opencv</exec_depend>
    <exec_depend>python3-pil</exec_depend>
    <exec_depend>python3-matplotlib</exec_depend>
    <exec_depend>python3-yaml</exec_depend>
    <exec_depend>python3-ruamel.yaml</exec_depend>
    <!-- cupy (mapper) and torch + tensorrt (samtp_node only) come from pip / JetPack: see requirements.txt, HAECHI_BOARD.md -->

    <export>
        <build_type>ament_cmake</build_type>
    </export>
</package>
